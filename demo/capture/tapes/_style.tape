# Shared look for every Obol demo tape: black, uniform, readable at phone size.
Set Shell "bash"
Set FontFamily "JetBrains Mono"
Set FontSize 30
Set Width 1920
Set Height 1080
Set Padding 44
Set LineHeight 1.25
Set Theme { "name": "Obol Mono", "black": "#111111", "red": "#ff6b5a", "green": "#9be29b", "yellow": "#f2d27a", "blue": "#8fb8ff", "magenta": "#ff7ac6", "cyan": "#86e0e0", "white": "#e8e6e1", "brightBlack": "#6f6b65", "brightRed": "#ff8b7d", "brightGreen": "#b7f0b7", "brightYellow": "#ffe39a", "brightBlue": "#b0ccff", "brightMagenta": "#ff9ed6", "brightCyan": "#a8eeee", "brightWhite": "#ffffff", "background": "#0b0b0b", "foreground": "#e8e6e1", "selection": "#333333", "cursor": "#e8e6e1" }
Set TypingSpeed 22ms
Set WaitTimeout 240s
